# Force LF line endings for everything that runs on Linux.
# Without this, files authored on Windows end up with CRLF and bash reads
# the shebang as "#!/usr/bin/env bash\r" → "command not found" on Linux.

*               text=auto eol=lf
*.sh            text eol=lf
*.bash          text eol=lf
*.bats          text eol=lf
Makefile        text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.md            text eol=lf

# Binary types — never touch these
*.png           binary
*.jpg           binary
*.ico           binary
