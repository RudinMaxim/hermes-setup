# Native macOS setup. Copy to config/macos.env and adjust if needed.

# Existing Obsidian Git repository used as the vault.
OBSIDIAN_REPO=/Users/Shered/srv/apps/obsidian_store
OBSIDIAN_REMOTE=origin
OBSIDIAN_BRANCH=main
OBSIDIAN_SYNC_INTERVAL=300

# Local Ollama profile.
OLLAMA_PROFILE=ollama
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_WATCH_INTERVAL=60

# Health-check sends Telegram messages only when failure state changes.
HERMES_HEALTH_INTERVAL=900
HEALTHCHECK_TELEGRAM_CHAT_ID=745637014

# Updates are checked explicitly and applied only with make update-macos.
HERMES_EXPECTED_VERSION=0.15.0
HERMES_UPDATE_BRANCH=main
HERMES_PLAYWRIGHT_MCP_VERSION=0.0.76

# Native speech and multimodal analysis.
HERMES_STT_MODEL=base
HERMES_STT_LANGUAGE=ru
HERMES_TTS_VOICE=Milena
HERMES_VISION_MODEL=google/gemini-3-flash-preview
