# config/.env.example
# Copy to config/.env and fill in values. NEVER commit config/.env (gitignored).

# ── LLM provider (at least one is required) ───────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Host directory mounted into the Hermes container for Filesystem MCP.
# Keep the default unless you also update config/mcp.toml [filesystem].mount.
HERMES_PROJECTS_DIR=/home/hermes/projects

# Base image used only when the upstream Hermes image pull fails and the
# fallback local build is needed. ECR Public avoids Docker Hub anonymous limits.
HERMES_FALLBACK_BASE_IMAGE=public.ecr.aws/docker/library/ubuntu:26.04

# ── MCP secrets — fill only for MCPs you enable in config/mcp.toml ────────
# docs/mcp/github.md
GITHUB_TOKEN=
# docs/mcp/context7.md (optional — anonymous tier works without it)
CONTEXT7_API_KEY=
# docs/mcp/postgresql.md   format: postgresql://user:pass@host:5432/db
POSTGRES_URL=
