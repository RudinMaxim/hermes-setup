# config/.env.example
# Copy to config/.env and fill in values. NEVER commit config/.env (gitignored).

# ── LLM provider (at least one is required) ───────────────────────────────
# Yandex AI Studio + SpeechKit (recommended for the VPS migration).
# Create one service-account API key with yc.ai.foundationModels.execute.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Default Hermes model written to /home/hermes/.hermes/config.yaml.
HERMES_MODEL_PROVIDER=openrouter
HERMES_MODEL=openai/gpt-5.4-mini

# Telegram voice backend. Set to yandex to use SpeechKit v3 for long OggOpus.
HERMES_STT_PROVIDER=yandex
HERMES_YANDEX_STT_MODEL=general
HERMES_YANDEX_STT_TIMEOUT=600

# Host directory mounted into the Hermes container as /home/hermes/projects.
# Hermes' built-in file tools operate on this path inside the container.
HERMES_PROJECTS_DIR=/home/hermes/projects

# Base image used only when the upstream Hermes image pull fails and the
# fallback local build is needed. ECR Public avoids Docker Hub anonymous limits.
HERMES_FALLBACK_BASE_IMAGE=public.ecr.aws/docker/library/ubuntu:24.04

# ── MCP secrets — fill only for MCPs you enable in config/mcp.toml ────────
# playwright and docker_mcp need no secrets. Add vars here for any MCP you
# wire up manually later (see docs/mcp/<name>.md).
